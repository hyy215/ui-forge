{
  "name": "ui-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A VS Code integrated D2C agent for React projects.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "tsc -b packages/shared-protocol packages/client-core packages/codex-client",
    "build:apps": "tsc -b apps/agent-server apps/agent-webview apps/vscode-extension apps/agent-cli && npm run build -w @ui-forge/agent-webview",
    "package:vsix": "node apps/vscode-extension/scripts/package-vsix.mjs",
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc -b tsconfig.json",
    "verify": "npm run check && npm run build:apps",
    "dev:server": "npm run dev -w @ui-forge/agent-server",
    "dev:webview": "npm run dev -w @ui-forge/agent-webview",
    "dev:webview:server": "npm run dev:server -w @ui-forge/agent-webview",
    "test": "vitest run",
    "test:e2e": "playwright test --config apps/agent-webview/playwright.config.ts",
    "test:watch": "vitest",
    "regression:prepare": "node scripts/regression/run.mjs prepare",
    "regression:summarize": "node scripts/regression/run.mjs summarize",
    "benchmark:history": "node apps/agent-webview/scripts/benchmark-history.mjs",
    "ui-forge": "node apps/agent-cli/dist/main.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
