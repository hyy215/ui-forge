# 使用已登录的 Codex CLI，当前原生协议对应 0.153.4。
# 优先从 PATH 查找；macOS 也查找 Codex/ChatGPT 应用与常见安装目录。
# 手动指定时使用绝对路径；修改后重启 agent-server。
UI_FORGE_CODEX_PATH=
UI_FORGE_CODEX_MODEL=

# 页面与 CLI 共用本机服务。
UI_FORGE_HOST=127.0.0.1
UI_FORGE_PORT=4310

# 运行目录存放服务锁、会话导航索引和上传图片；相对路径以安装根解析。
UI_FORGE_RUNTIME_DIR=.ui-forge/runtime

# MasterGo HTTP MCP 令牌；仅在读取实时设计时需要。
MG_MCP_TOKEN=
