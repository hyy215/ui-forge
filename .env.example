UI_FORGE_HOST=127.0.0.1
UI_FORGE_PORT=4310
UI_FORGE_RUNTIME_DIR=.ui-forge/runtime
DATABASE_URL=postgresql://ui_forge:ui_forge@localhost:5432/ui_forge
MODEL_API_KEY=
MODEL_PROFILE=bailian-balanced
MODEL_PROVIDER=bailian
MODEL_NAME=
MODEL_BASE_URL=
# 留空时由预设选择结构化协议；原有配置可使用 MODEL_PROFILE=legacy。
MODEL_STRUCTURED_OUTPUT_MODE=
MODEL_PLAN_NAME=qwen3.7-plus
MODEL_PLAN_THINKING=true
MODEL_PLAN_THINKING_BUDGET=4096
MODEL_VISION_NAME=qwen3.7-plus
MODEL_VISION_THINKING=false
MODEL_REPAIR_NAME=qwen3.8-flash
MODEL_REPAIR_THINKING=false
MODEL_ESCALATION_NAME=qwen3.8-max
MODEL_ESCALATION_THINKING=true
MODEL_ESCALATION_THINKING_BUDGET=8192
UI_FORGE_COMPONENT_CATALOG_PATH=
UI_FORGE_CHECKPOINT_SCHEMA=public
UI_FORGE_ARTIFACT_DIR=.ui-forge/artifacts
UI_FORGE_ARTIFACT_PENDING_RETENTION_HOURS=24
UI_FORGE_DESIGN_PROVIDER=mastergo
UI_FORGE_LOG_DIR=.ui-forge/logs
UI_FORGE_LOG_RETENTION_DAYS=90
MG_MCP_TOKEN=
MASTERGO_BASE_URL=https://mastergo.com
