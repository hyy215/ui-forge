{
  "name": "@ui-forge/vscode-extension",
  "displayName": "ui-forge",
  "description": "D2C agent integrated with VS Code.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "dependencies": {
    "@ui-forge/shared-protocol": "0.1.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "ui-forge.open",
        "title": "ui-forge: Open Agent"
      },
      {
        "command": "ui-forge.createTask",
        "title": "创建任务",
        "icon": "$(add)"
      },
      {
        "command": "ui-forge.openTask",
        "title": "打开任务"
      },
      {
        "command": "ui-forge.renameTask",
        "title": "重命名任务"
      },
      {
        "command": "ui-forge.archiveTask",
        "title": "归档任务"
      },
      {
        "command": "ui-forge.restoreTask",
        "title": "恢复任务"
      },
      {
        "command": "ui-forge.deleteTask",
        "title": "永久删除任务",
        "icon": "$(trash)"
      },
      {
        "command": "ui-forge.refreshTasks",
        "title": "刷新任务",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ui-forge",
          "title": "ui-forge",
          "icon": "media/ui-forge.svg"
        }
      ]
    },
    "views": {
      "ui-forge": [
        {
          "id": "ui-forge.sidebar",
          "name": "ui-forge"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ui-forge.createTask",
          "when": "view == ui-forge.sidebar",
          "group": "navigation"
        },
        {
          "command": "ui-forge.refreshTasks",
          "when": "view == ui-forge.sidebar",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ui-forge.openTask",
          "when": "view == ui-forge.sidebar && (viewItem == uiForgeActiveTask || viewItem == uiForgeArchivedTask)",
          "group": "navigation@1"
        },
        {
          "command": "ui-forge.renameTask",
          "when": "view == ui-forge.sidebar && (viewItem == uiForgeActiveTask || viewItem == uiForgeArchivedTask)",
          "group": "navigation@2"
        },
        {
          "command": "ui-forge.archiveTask",
          "when": "view == ui-forge.sidebar && viewItem == uiForgeActiveTask",
          "group": "navigation@3"
        },
        {
          "command": "ui-forge.restoreTask",
          "when": "view == ui-forge.sidebar && viewItem == uiForgeArchivedTask",
          "group": "navigation@3"
        },
        {
          "command": "ui-forge.deleteTask",
          "when": "view == ui-forge.sidebar && (viewItem == uiForgeActiveTask || viewItem == uiForgeArchivedTask)",
          "group": "inline@4"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "1.125.0"
  }
}
