{
  "name": "@ui-forge/agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/agentServer.js",
  "types": "dist/agentServer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agentServer.d.ts",
      "import": "./dist/agentServer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ui-forge/shared-protocol": "0.1.0",
    "fastify": "5.11.3",
    "zod": "4.4.3",
    "@ui-forge/codex-client": "0.1.0",
    "@ui-forge/client-core": "0.1.0"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
