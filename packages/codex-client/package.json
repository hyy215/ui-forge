{
  "name": "@ui-forge/codex-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "check": "node scripts/inspect-d2c.mjs --check",
    "dry-run": "node scripts/inspect-d2c.mjs --dry-run",
    "test:live": "UI_FORGE_CODEX_LIVE=1 vitest run --root ../.. packages/codex-client/src/codexClient.live.test.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
